# ============================================================
# CleanTex Pro — Variables d'environnement
# Copiez ce fichier en .env pour usage local,
# ou configurez ces variables directement sur Render.
# ============================================================

# Port d'écoute (Render injecte automatiquement PORT=10000)
PORT=3000

# Code PIN admin (changez-le avant déploiement !)
ADMIN_PIN=2026

# WhatsApp du gérant (avec indicatif pays, sans espaces)
WHATSAPP_NUMBER=33184742000

# Email de notification
ADMIN_EMAIL=contact@cleantex-pro.fr

# Webhook Discord/Slack (optionnel)
WEBHOOK_URL=
WEBHOOK_ENABLED=false
